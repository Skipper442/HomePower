<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#111318" />
            <stroke android:width="2dp" android:color="#2F3440" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="5dp">
        <clip android:clipOrientation="vertical" android:gravity="bottom">
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <solid android:color="#5AA9FF" />
            </shape>
        </clip>
    </item>
</layer-list>
